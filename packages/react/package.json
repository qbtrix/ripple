{
  "name": "@ripple-ui/react",
  "version": "0.1.0",
  "license": "MIT",
  "description": "React component for Ripple: renders a Ripple JSON spec through @ripple-ui/embed. Needs no Svelte or Tailwind.",
  "keywords": [
    "react",
    "ui",
    "json-spec",
    "renderer",
    "ai",
    "generative-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qbtrix/ripple-iui.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/qbtrix/ripple-iui#readme",
  "bugs": {
    "url": "https://github.com/qbtrix/ripple-iui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@ripple-ui/embed": "file:../embed"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
