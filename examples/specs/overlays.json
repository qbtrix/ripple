{
  "version": "1.0",
  "ui": {
    "type": "card",
    "props": { "title": "Overlays in a shadow root" },
    "children": [
      {
        "type": "flex",
        "props": { "gap": "12px", "align": "center" },
        "children": [
          { "type": "tooltip", "props": { "trigger": "Hover me", "content": "Tooltip from inside the shadow root.", "side": "bottom" } },
          {
            "type": "dropdown-menu",
            "props": {
              "label": "Actions",
              "items": [
                { "label": "Edit", "icon": "pencil", "value": "edit" },
                { "label": "Duplicate", "icon": "copy", "value": "duplicate" }
              ]
            },
            "on_change": { "action": "emit", "event": "menu_pick", "payload": { "value": "{event}" } }
          }
        ]
      }
    ]
  }
}
